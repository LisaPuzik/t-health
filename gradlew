#!/bin/sh
# Gradle wrapper stub: Android Studio сгенерирует настоящий wrapper при открытии проекта.
# Либо скачай gradle-wrapper.jar вручную (см. README).
APP_BASE_NAME=${0##*/}
APP_HOME=${0%/*}
exec "$APP_HOME/gradlew.bat" "$@" 2>/dev/null || echo "Use Android Studio to sync this project (it will generate the Gradle wrapper)."
